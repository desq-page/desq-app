{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "string",
      "maxLength": 3,
      "enum": [
        "1.0"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "audience": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "objective": {
      "type": "string",
      "minLength": 1,
      "maxLength": 400
    },
    "design": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "palette": {
          "type": "string",
          "maxLength": 16,
          "enum": [
            "ocean",
            "forest",
            "ember",
            "plum",
            "graphite"
          ]
        }
      },
      "required": [
        "palette"
      ]
    },
    "slides": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "purpose": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "layout": {
            "type": "string",
            "maxLength": 20,
            "enum": [
              "cover",
              "closing",
              "statement",
              "content",
              "comparison",
              "three-column",
              "metrics",
              "timeline",
              "process",
              "agenda",
              "svg",
              "html"
            ]
          },
          "subtitle": {
            "type": "string",
            "minLength": 1,
            "maxLength": 220
          },
          "body": {
            "type": "string",
            "minLength": 1,
            "maxLength": 900
          },
          "bullets": {
            "type": "array",
            "maxItems": 6,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 220
            }
          },
          "items": {
            "type": "array",
            "maxItems": 6,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "title": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 90
                },
                "body": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 300
                },
                "value": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 40
                }
              },
              "required": [
                "title"
              ]
            }
          },
          "takeaway": {
            "type": "string",
            "minLength": 1,
            "maxLength": 220
          },
          "images": {
            "type": "array",
            "maxItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "query": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 160
                },
                "alt": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                }
              },
              "required": [
                "query",
                "alt"
              ]
            }
          },
          "illustration": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "description": "Suggested image subject and context; Desq derives Wikimedia search keywords from this description."
          },
          "svg": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80000,
            "description": "For layout svg only: complete editable slide SVG using viewBox=\"0 0 1280 720\"."
          },
          "html": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80000,
            "description": "For layout html only: one complete 1280 by 720 HTML section containing the full editable slide."
          }
        },
        "required": [
          "title",
          "purpose",
          "layout"
        ]
      }
    }
  },
  "required": [
    "version",
    "title",
    "audience",
    "objective",
    "design",
    "slides"
  ]
}
