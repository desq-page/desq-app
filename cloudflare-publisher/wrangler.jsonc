{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "desq-publisher",
	"main": "src/worker.js",
	"compatibility_date": "2026-10-06",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"durable_objects": {
		"bindings": [
			{
				"name": "AGENT_SESSIONS",
				"class_name": "AgentSession"
			}
		]
	},
	"migrations": [
		{
			"tag": "agent-sessions-v1",
			"new_sqlite_classes": [
				"AgentSession"
			]
		}
	],
	"workers_dev": false,
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1
	},
	"assets": {
		"directory": "../editor-vuejs/dist",
		"binding": "ASSETS",
		"run_worker_first": true,
		"not_found_handling": "single-page-application"
	},
	"routes": [
		{
			"pattern": "desq.page",
			"custom_domain": true
		},
		{
			"pattern": "publish-api.desq.page",
			"custom_domain": true
		}
	],
	"r2_buckets": [
		{
			"binding": "CONTENT",
			"bucket_name": "desq-published"
		},
		{
			"binding": "APP_FILES",
			"bucket_name": "desq-app-assets"
		},
		{
			"bucket_name": "desq-published",
			"binding": "desq_published",
			"remote": true
		},
		{
			"bucket_name": "desq-app-assets",
			"binding": "desq_app_assets",
			"remote": true
		}
	],
	"vars": {
		"PUBLIC_ORIGIN": "https://desq.page",
		"API_ORIGIN": "https://publish-api.desq.page",
		"ALLOWED_ORIGINS": "https://desq.page,https://localhost:6173",
		"APP_LARGE_ASSET_PATHS": "/rmbg/isnet/onnx/model.onnx,/rmbg/isnet/onnx/model_fp16.onnx",
		"GOOGLE_CLIENT_ID": "712080911540-dgan2oeith32lagdq9nh7cqu5op109ki.apps.googleusercontent.com"
	}
}
